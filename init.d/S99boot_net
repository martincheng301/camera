#!/bin/sh
# Boot-time network state machine.

echo "S99: start $(date)" >> /tmp/s99_diag
. /userdata/ap_test/scripts/lib.sh

retry=0
while [ "$retry" -lt 4 ]; do
    echo "S99: attempt $((retry+1))/4" >> /tmp/s99_diag
    set +e
    /userdata/ap_test/boot_network.sh "$@" >> /tmp/s99_diag 2>&1
    code=$?
    set -e
    if [ "$code" -eq 0 ]; then
        echo "S99: success on attempt $((retry+1))" >> /tmp/s99_diag
        exit 0
    fi
    echo "S99: failed (exit=$code), retry in 5s" >> /tmp/s99_diag
    retry=$((retry + 1))
    sleep 5
done

echo "S99: failed after 4 attempts" >> /tmp/s99_diag
exit 1
