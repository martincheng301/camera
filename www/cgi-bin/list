#!/bin/sh
# GET /cgi-bin/list
# {"dir":"...","recording":false,"files":[{"name":"...","size":...,"mtime":...},...]}

printf 'Content-Type: application/json\r\n\r\n'

. /userdata/ap_test/scripts/lib.sh
detect_storage
VIDEO_DIR="$RECORD_DIR"

_json_str() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# A process holding an fd open inside VIDEO_DIR means the file is
# still being written (i.e. recording is active).  This is agnostic
# to whether the recording was triggered by native entry.cgi or
# our control_record.sh.
_is_recording() {
    ls -l /proc/[0-9]*/fd/* 2>/dev/null | grep -q "$VIDEO_DIR/"
}

if _is_recording; then
    recording=true
else
    recording=false
fi

printf '{"dir":"'
_json_str "$VIDEO_DIR"
printf '","recording":%s,"files":[' "$recording"

first=1
for f in "$VIDEO_DIR"/*; do
    [ -f "$f" ] || continue

    name=$(basename "$f")
    size=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
    [ -n "$size" ] || size=0
    mtime=$(date -r "$f" +%s 2>/dev/null || echo 0)

    if [ "$first" -eq 1 ]; then
        first=0
    else
        printf ','
    fi

    printf '{"name":"'
    _json_str "$name"
    printf '","size":%s,"mtime":%s}' "$size" "$mtime"
done

printf ']}\n'
